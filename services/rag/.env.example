# Inject credentials via environment or secret manager; never commit actual values
OPENAI_API_KEY=replace-me
RAG_API_TOKEN=replace-with-long-random-internal-service-token
RAG_DOCS_ROOT=../../docs
RAG_PGVECTOR_DSN=postgresql://rag_reader:password@localhost:5432/inventory
RAG_COLLECTION=investory_docs
RAG_CHAT_MODEL=gpt-5-mini
RAG_CHAT_REASONING_EFFORT=minimal
RAG_EMBEDDING_PROVIDER=local
RAG_LOCAL_MODEL_CACHE=./data/models
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_OPENAI_TIMEOUT_SECONDS=20
RAG_MAX_CONCURRENT_REQUESTS=1
RAG_TOP_K=4
RAG_MIN_RELEVANCE_SCORE=0.3

# Optional read-only market data; provision a remote OAuth bearer credential securely.
RAG_FINANCIAL_MCP_ENABLED=false
# RAG_FINANCIAL_MCP_API_KEY=provider-api-key-injected-by-secret-manager
# RAG_FINANCIAL_MCP_ACCESS_TOKEN=oauth-bearer-token-from-secret-manager
RAG_FINANCIAL_MCP_TIMEOUT_SECONDS=12
